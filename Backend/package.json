{
  "name": "muve-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "node --watch src/server.ts",
    "start": "NODE_ENV=production node src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "node scripts/test-db.mjs",
    "test:e2e": "node scripts/e2e-local.mjs",
    "format": "oxfmt"
  },
  "dependencies": {
    "@muve/shared": "link:../shared",
    "@hono/node-server": "^2.1.7",
    "@supabase/supabase-js": "^2.117.2",
    "hono": "^4.13.18",
    "nodemailer": "^10.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "oxfmt": "^0.2.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
